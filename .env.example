# Copy to .env and adjust as needed. .env is gitignored.
#
# Defaults match docker-compose.yml so the stack runs with no edits for
# local development. Change POSTGRES_PASSWORD for any non-local use.

POSTGRES_USER=deal_desk
POSTGRES_PASSWORD=deal_desk_dev
POSTGRES_DB=deal_desk
POSTGRES_PORT=5432

# Application-level connection string. Reads of this value are the single
# source of truth for where the app and Alembic connect.
DATABASE_URL=postgresql+psycopg2://deal_desk:deal_desk_dev@localhost:5432/deal_desk

# Test-only database. Required for database integration tests. Must point
# at a database whose name ends in `_test` or the tests fail-closed and
# refuse to run (prevents accidental writes to the dev database).
TEST_DATABASE_URL=postgresql+psycopg2://deal_desk:deal_desk_dev@localhost:5432/deal_desk_test

# Dedicated, disposable migration-test database. NEVER use DATABASE_URL or
# TEST_DATABASE_URL for destructive migration round-trip tests.
MIGRATION_TEST_DATABASE_URL=postgresql+psycopg2://deal_desk:deal_desk_dev@localhost:5432/deal_desk_migration_test
